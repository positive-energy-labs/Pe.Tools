 static void EachTriangle(Element element,Transform transform,ViewDetailLevel detail,Action<XYZ,XYZ,XYZ> triangle,Action<Triangle,Rounded[]> detailed=null,Action<int> instanceDepth=null,Action<int> rootCount=null) {
