 readonly record struct Rounded(Vector3 Position,double Error);
 static double ClipError(Rounded[] input,double[][] bounds) {
  var greatest=input.Max(p=>p.Error);
  float At(Vector3 p,int axis)=>axis==0?p.X:axis==1?p.Y:p.Z;
  if(input.All(p=>Enumerable.Range(0,3).All(axis=>At(p.Position,axis)>=bounds[axis][0] && At(p.Position,axis)<=bounds[axis][1])))return greatest;
  var polygon=input.ToList();
  for(var axis=0;axis<3;axis++)for(var side=0;side<2;side++) {
   if(polygon.Count==0)break;
   var output=new List<Rounded>();var previous=polygon[polygon.Count-1];var pd=At(previous.Position,axis)-bounds[axis][side];
   foreach(var current in polygon) {
    var d=At(current.Position,axis)-bounds[axis][side];
    if((d>=0)!=(pd>=0)) {
     var amount=(float)(pd/(pd-d));var actual=Vector3.Lerp(previous.Position,current.Position,amount);
     var a=Point.Of(previous.Position);var b=Point.Of(current.Position);
     var ideal=a*(1-(double)amount)+b*amount;
     // Any amount in [0,1] stays inside the original triangle. Parameter rounding changes the
     // cut position, but cannot move it off that triangle; only Lerp arithmetic adds surface error.
     if(amount<0||amount>1)throw new Exception("Non-convex clipping interpolation");
     var error=previous.Error*(1-(double)amount)+current.Error*amount+(Point.Of(actual)-ideal).Length;
     output.Add(new Rounded(actual,error));greatest=Math.Max(greatest,error);
    }
    if(side==0?d>=0:d<=0)output.Add(current);
    previous=current;pd=d;
   }
   polygon=output;
  }
  return greatest;
 }
