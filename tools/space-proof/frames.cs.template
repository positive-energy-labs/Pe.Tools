using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using Autodesk.Revit.DB;
using Newtonsoft.Json.Linq;

// Space proof harness, accuracy pass. Read-only. For every (link instance id | null, element id) the published
// PSC1 artifact drew, read the element's OWN frame in Revit and return [index, frame, rotated, yawDeg*10, tiltDeg*10, ratio*100].
//   frame   1 instance transform  2 location line  3 curved location  4 sampled geometry (yaw fit)  0 none readable
//   rotated 1 own frame is not square to the host axes (beyond 0.5 deg), 0 square, -1 unknown
// Frames are composed with the placed link instance's total transform, never the link document's.
public sealed class Frames : PeScriptContainer {
    const string Request = @"__REQ__";
    const double Tol = 0.5; // degrees from a world axis
    static bool Axial(XYZ v) { v = v.Normalize(); return Math.Max(Math.Abs(v.X), Math.Max(Math.Abs(v.Y), Math.Abs(v.Z))) >= Math.Cos(Tol * Math.PI / 180); }
    static double Deg(double rad) => rad * 180 / Math.PI;

    static void Points(GeometryElement g, Transform t, List<XYZ> into) {
        foreach (var o in g) {
            switch (o) {
                case Solid s when s.Faces.Size > 0:
                    foreach (Face f in s.Faces) { using var m = f.Triangulate(0.2); foreach (var v in m.Vertices) into.Add(t.OfPoint(v)); }
                    break;
                case Mesh m: foreach (var v in m.Vertices) into.Add(t.OfPoint(v)); break;
                case GeometryInstance gi: Points(gi.GetInstanceGeometry(), t, into); break;
            }
        }
    }

    // Smallest yaw-only (about Z) oriented footprint against the axis-aligned one: the box a world-axis-aligned drawing would lie about.
    static (double yaw, double ratio)? YawFit(List<XYZ> pts) {
        if (pts.Count < 4) return null;
        double Area(double a) {
            double c = Math.Cos(a), s = Math.Sin(a), x0 = 1e300, x1 = -1e300, y0 = 1e300, y1 = -1e300;
            foreach (var p in pts) { var x = p.X * c + p.Y * s; var y = -p.X * s + p.Y * c; x0 = Math.Min(x0, x); x1 = Math.Max(x1, x); y0 = Math.Min(y0, y); y1 = Math.Max(y1, y); }
            return (x1 - x0) * (y1 - y0);
        }
        var axis = Area(0); if (axis <= 1e-9) return null;
        double best = axis, bestA = 0;
        for (var d = 1; d < 90; d++) { var a = Area(d * Math.PI / 180); if (a < best) { best = a; bestA = d; } }
        return (bestA, axis / best);
    }

    public override void Execute() {
        var before = doc!.IsModified;
        var req = JObject.Parse(File.ReadAllText(Request));
        var items = (JArray)req["items"]!;
        var sample = (int)req["geometrySamplePerSource"]!;
        var docs = new Dictionary<long, (Document? D, Transform T)>();
        (Document? D, Transform T) Source(long? link) {
            var key = link ?? -1;
            if (docs.TryGetValue(key, out var cached)) return cached;
            (Document? D, Transform T) r = (doc, Transform.Identity);
            if (link is { } id) {
                var li = doc.GetElement(new ElementId(id)) as RevitLinkInstance;
                r = li?.GetLinkDocument() is { } ld ? (ld, li.GetTotalTransform()) : (null, Transform.Identity);
            }
            return docs[key] = r;
        }
        var taken = new Dictionary<long, int>();
        var rows = new JArray();
        for (var i = 0; i < items.Count; i++) {
            var it = items[i];
            long? link = it["link"]!.Type == JTokenType.Null ? null : (long)it["link"]!;
            var (d, t) = Source(link);
            var e = d?.GetElement(new ElementId((long)it["id"]!));
            if (e is null) { rows.Add(new JArray(i, 0, -1, 0, 0, 0)); continue; }
            if (e is Instance inst && inst.GetTotalTransform() is { } own) {
                var tt = t.Multiply(own);
                var tilt = Deg(Math.Acos(Math.Min(1, Math.Abs(tt.BasisZ.Normalize().Z))));
                rows.Add(new JArray(i, 1, Axial(tt.BasisX) && Axial(tt.BasisY) && Axial(tt.BasisZ) ? 0 : 1,
                    (int)Math.Round(Deg(Math.Atan2(tt.BasisX.Y, tt.BasisX.X)) * 10), (int)Math.Round(tilt * 10), 0));
                continue;
            }
            if (e.Location is LocationCurve lc) {
                if (lc.Curve is Line line) {
                    var dir = t.OfVector(line.Direction);
                    rows.Add(new JArray(i, 2, Axial(dir) ? 0 : 1, (int)Math.Round(Deg(Math.Atan2(dir.Y, dir.X)) * 10),
                        (int)Math.Round(Deg(Math.Asin(Math.Min(1, Math.Abs(dir.Normalize().Z)))) * 10), 0));
                } else rows.Add(new JArray(i, 3, -1, 0, 0, 0));
                continue;
            }
            var k = link ?? -1; taken.TryGetValue(k, out var n);
            if (n < sample && (long)it["id"]! % 7 == 0) { // deterministic subset; bounded geometry cost
                taken[k] = n + 1;
                var pts = new List<XYZ>();
                try { using var opt = new Options { DetailLevel = ViewDetailLevel.Coarse }; using var g = e.get_Geometry(opt); if (g != null) Points(g, t, pts); } catch { }
                if (YawFit(pts) is { } fit) { rows.Add(new JArray(i, 4, fit.ratio > 1.15 ? 1 : 0, (int)Math.Round(fit.yaw * 10), 0, (int)Math.Round(fit.ratio * 100))); continue; }
            }
            rows.Add(new JArray(i, 0, -1, 0, 0, 0));
        }
        if (doc.IsModified != before) throw new InvalidOperationException("IsModified changed");
        Result(new JObject { ["rows"] = rows, ["sources"] = new JObject(docs.Select(kv => new JProperty(kv.Key.ToString(), new JObject {
            ["loaded"] = kv.Value.D != null, ["origin"] = kv.Value.D == null ? null : new JArray(kv.Value.T.Origin.X, kv.Value.T.Origin.Y, kv.Value.T.Origin.Z),
            ["yawDeg"] = kv.Value.D == null ? 0 : Deg(Math.Atan2(kv.Value.T.BasisX.Y, kv.Value.T.BasisX.X)) }))),
            ["isModifiedBefore"] = before, ["isModifiedAfter"] = doc.IsModified });
    }
}
