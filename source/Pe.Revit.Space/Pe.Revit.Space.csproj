<Project Sdk="Pe.Revit.Sdk">

    <PropertyGroup>
        <PeProjectKind>RevitLibrary</PeProjectKind>
    </PropertyGroup>

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Pe.Revit.Space</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ILRepack" Version="2.0.44">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4"/>
        <!-- ponytail: 2025.2.4 adds long.ToElementId() ambiguous with Pe.Revit.Compat (CS0121); unpin when one owner is chosen -->
        <PackageReference Include="Nice3point.Revit.Extensions" Version="2025.2.4" Condition="'$(RevitVersion)' == '2025'"/>
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*" Condition="'$(RevitVersion)' != '2025'"/>
        <PackageReference Include="Serilog" Version="4.3.0"/>
        <!-- IDocumentTracker and GetDocumentKey come from the SDK loader, not from Pe.Revit.Global.
             Referencing Global made Space -> Global, which turns Global -> Takeoff -> Partition ->
             Space into a project cycle the moment the partition exists. -->
        <PackageReference Include="Pe.Revit.Loader" Version="$(PeSdkCompanionVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pe.Revit\Pe.Revit.csproj"/>
    </ItemGroup>

</Project>
