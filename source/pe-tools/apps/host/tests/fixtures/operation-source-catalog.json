    "requestSchemaJson": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"title\": \"ParameterValueApplyRequest\",\r\n  \"type\": \"object\",\r\n  \"description\": \"Bounded project-document parameter mutation contracts. Edits redeem \\\"binding handles\\\"\\n(target element id + parameter id) produced by the schedule cell-binding surface\\n(revit.detail.schedules projection.includeBindings), so ParameterId is the preferred\\naddressing form; ParameterName is a fallback for name-only callers.\\n            \",\r\n  \"additionalProperties\": false,\r\n  \"required\": [\r\n    \"edits\"\r\n  ],\r\n  \"properties\": {\r\n    \"edits\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"$ref\": \"#/definitions/ParameterValueEdit\"\r\n      }\r\n    },\r\n    \"dryRun\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"transactionName\": {\r\n      \"type\": [\r\n        \"null\",\r\n        \"string\"\r\n      ]\r\n    }\r\n  },\r\n  \"definitions\": {\r\n    \"ParameterValueEdit\": {\r\n      \"type\": \"object\",\r\n      \"additionalProperties\": false,\r\n      \"required\": [\r\n        \"elementId\"\r\n      ],\r\n      \"properties\": {\r\n        \"elementId\": {\r\n          \"type\": \"integer\",\r\n          \"format\": \"int64\"\r\n        },\r\n        \"parameterId\": {\r\n          \"type\": [\r\n            \"integer\",\r\n            \"null\"\r\n          ],\r\n          \"format\": \"int64\"\r\n        },\r\n        \"parameterName\": {\r\n          \"type\": [\r\n            \"null\",\r\n            \"string\"\r\n          ]\r\n        },\r\n        \"value\": {\r\n          \"type\": [\r\n            \"null\",\r\n            \"string\"\r\n          ]\r\n        },\r\n        \"unit\": {\r\n          \"type\": [\r\n            \"null\",\r\n            \"string\"\r\n          ]\r\n        },\r\n        \"rawInternal\": {\r\n          \"type\": \"boolean\"\r\n        }\r\n      }\r\n    }\r\n  }\r\n}",
    "responseSchemaJson": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"title\": \"ParameterValueApplyData\",\r\n  \"type\": \"object\",\r\n  \"additionalProperties\": false,\r\n  \"required\": [\r\n    \"applied\",\r\n    \"dryRun\",\r\n    \"results\"\r\n  ],\r\n  \"properties\": {\r\n    \"applied\": {\r\n      \"type\": \"integer\",\r\n      \"format\": \"int32\"\r\n    },\r\n    \"dryRun\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"results\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"$ref\": \"#/definitions/ParameterValueEditResult\"\r\n      }\r\n    }\r\n  },\r\n  \"definitions\": {\r\n    \"ParameterValueEditResult\": {\r\n      \"type\": \"object\",\r\n      \"additionalProperties\": false,\r\n      \"required\": [\r\n        \"index\",\r\n        \"ok\"\r\n      ],\r\n      \"properties\": {\r\n        \"index\": {\r\n          \"type\": \"integer\",\r\n          \"format\": \"int32\"\r\n        },\r\n        \"ok\": {\r\n          \"type\": \"boolean\"\r\n        },\r\n        \"error\": {\r\n          \"type\": [\r\n            \"null\",\r\n            \"string\"\r\n          ]\r\n        },\r\n        \"parsedRaw\": {\r\n          \"type\": [\r\n            \"null\",\r\n            \"string\"\r\n          ]\r\n        },\r\n        \"parsedDisplay\": {\r\n          \"type\": [\r\n            \"null\",\r\n            \"string\"\r\n          ]\r\n        }\r\n      }\r\n    }\r\n  }\r\n}"
