{
  "family": {
    "name": "PE Wall Sink",
    "category": "Plumbing Fixtures",
    "template": "Plumbing Fixture wall based",
    "placement": "WallHosted"
  },
  "familyParameters": {
    "Basin Width": {
      "dataType": "Length (Common)",
      "value": "20in"
    },
    "Basin Depth": {
      "dataType": "Length (Common)",
      "value": "16in"
    },
    "Basin Height": {
      "dataType": "Length (Common)",
      "value": "8in"
    },
    "Bowl Width": {
      "dataType": "Length (Common)",
      "value": "14in"
    },
    "Bowl Depth": {
      "dataType": "Length (Common)",
      "value": "10in"
    },
    "Bowl Height": {
      "dataType": "Length (Common)",
      "value": "6in"
    },
    "Waste Diameter": {
      "dataType": "Length (Common)",
      "value": "2in"
    },
    "Waste Elevation": {
      "dataType": "Length (Common)",
      "value": "3in"
    },
    "Stub Depth": {
      "dataType": "Length (Common)",
      "value": "2in"
    }
  },
  "types": {
    "Standard": {},
    "Compact": {
      "Basin Width": "16in",
      "Bowl Width": "11in"
    }
  },
  "planes": {
    "waste-elevation": {
      "from": "plane:family.Bottom",
      "by": "param:Waste Elevation",
      "direction": "Out"
    }
  },
  "frames": {
    "waste": {
      "origin": [
        "face:basin.Back",
        "plane:family.CenterLR",
        "plane:waste-elevation"
      ],
      "normal": "+Y",
      "up": "+Z"
    }
  },
  "solids": {
    "basin": {
      "kind": "Prism",
      "frame": "frame:family",
      "width": "param:Basin Width",
      "depth": "param:Basin Depth",
      "height": "param:Basin Height"
    },
    "bowl": {
      "kind": "VoidPrism",
      "frame": "frame:family",
      "width": "param:Bowl Width",
      "depth": "param:Bowl Depth",
      "height": "param:Bowl Height"
    }
  },
  "connectors": {
    "waste": {
      "domain": "Pipe",
      "frame": "frame:waste",
      "shape": "Round",
      "diameter": "param:Waste Diameter",
      "stub": {
        "depth": "param:Stub Depth",
        "direction": "In"
      },
      "systemType": "Sanitary",
      "flowDirection": "In"
    }
  }
}
