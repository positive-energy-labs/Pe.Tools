      },
      {
        "Parameter": "PE_G___NotesType",
        "CA550-R": "Modeled as the ComfoAir 550 R Luxe ERV using the service side as the family front. Top collar layout follows the installer manual right-hand orientation: outside air at back-left, supply air at back-right, exhaust air at front-left, and return air at front-right. Duct center spacing and row offsets come from the published top-view dimensions. Front maintenance clearance uses the 1 m minimum from the installer manual, while top clearance uses the 7.9 in electrical connection zone shown on the spec drawing. PE_M_Fan_AirFlowDesign was set to a reasonable middle value of 177 CFM. PE_M_Eff_SRE uses the published up-to-95% heat recovery figure; PE_M_Eff_LatentRecovery uses the up-to-65% moisture transfer note for the ERV enthalpy exchanger; TRE and branch-circuit protection values were not published."
      }
    ]
  },
  "ParamDrivenSolids": {
    "Frame": "NonHosted",
    "Planes": {
      "Back Row Center": {
        "From": "@CenterFB",
        "By": "param:BackRowOffset",
        "Dir": "in"
      },
      "Front Row Center": {
        "From": "@CenterFB",
        "By": "param:FrontRowOffset",
        "Dir": "out"
      },
      "Front Clearance": {
        "From": "@CenterFB",
        "By": "param:FrontClearanceFromCenter",
        "Dir": "out"
      },
      "Top Clearance": {
        "From": "@Bottom",
        "By": "param:TopClearanceFromBottom",
        "Dir": "out"
      }
    },
    "Spans": [
      {
        "About": "@CenterLR",
        "By": "param:CollarCenterSpacingLR",
        "Negative": "Duct Left Center",
        "Positive": "Duct Right Center"
      }
    ],
    "Prisms": [
      {
        "Name": "Cabinet",
        "IsSolid": true,
        "On": "@Bottom",
        "Width": {
          "About": "@CenterFB",
          "By": "param:PE_G_Dim_Width1",
          "Negative": "Cabinet Back",
          "Positive": "Cabinet Front"
        },
        "Length": {
          "About": "@CenterLR",
          "By": "param:PE_G_Dim_Length1",
          "Negative": "Cabinet Left",
          "Positive": "Cabinet Right"
        },
        "Height": {
          "Name": "Cabinet Top",
          "From": "@Bottom",
          "By": "param:PE_G_Dim_Height1",
          "Dir": "out"
        }
      }
    ],
    "Cylinders": [],
    "Connectors": [
      {
        "Name": "OutsideAir",
        "Domain": "Duct",
        "Face": "plane:Cabinet Top",
        "Depth": {
          "By": "param:CollarDepth",
          "Dir": "out"
        },
        "Round": {
          "Center": [
            "plane:Duct Left Center",
            "plane:Back Row Center"
          ],
          "Diameter": {
            "By": "param:CollarDiameter"
          }
        },
        "Config": {
          "SystemType": "OtherAir",
          "FlowConfiguration": "Preset",
          "FlowDirection": "In",
          "LossMethod": "NotDefined"
        }
      },
      {
        "Name": "SupplyAir",
        "Domain": "Duct",
        "Face": "plane:Cabinet Top",
        "Depth": {
          "By": "param:CollarDepth",
          "Dir": "out"
        },
        "Round": {
          "Center": [
            "plane:Duct Right Center",
            "plane:Back Row Center"
          ],
          "Diameter": {
            "By": "param:CollarDiameter"
          }
        },
        "Config": {
          "SystemType": "SupplyAir",
          "FlowConfiguration": "Preset",
          "FlowDirection": "Out",
          "LossMethod": "NotDefined"
        }
      },
      {
        "Name": "ExhaustAir",
        "Domain": "Duct",
        "Face": "plane:Cabinet Top",
        "Depth": {
          "By": "param:CollarDepth",
          "Dir": "out"
        },
        "Round": {
          "Center": [
            "plane:Duct Left Center",
            "plane:Front Row Center"
          ],
          "Diameter": {
            "By": "param:CollarDiameter"
          }
        },
        "Config": {
          "SystemType": "ExhaustAir",
          "FlowConfiguration": "Preset",
          "FlowDirection": "Out",
          "LossMethod": "NotDefined"
        }
      },
      {
        "Name": "ReturnAir",
        "Domain": "Duct",
        "Face": "plane:Cabinet Top",
        "Depth": {
          "By": "param:CollarDepth",
          "Dir": "out"
        },
        "Round": {
          "Center": [
            "plane:Duct Right Center",
            "plane:Front Row Center"
          ],
          "Diameter": {
            "By": "param:CollarDiameter"
          }
        },
        "Config": {
          "SystemType": "ReturnAir",
          "FlowConfiguration": "Preset",
          "FlowDirection": "In",
          "LossMethod": "NotDefined"
        }
      }
    ]
  },
