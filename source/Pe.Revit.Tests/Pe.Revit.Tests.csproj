<Project Sdk="Pe.Revit.Sdk">

    <PropertyGroup>
        <PeProjectKind>RevitTests</PeProjectKind>
    </PropertyGroup>
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTestProject>true</IsTestProject>
        <EnableRevitTestConfigurations>true</EnableRevitTestConfigurations>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit" Version="3.13.3" />
        <PackageReference Include="NetTopologySuite" Version="2.6.0" />
        <PackageReference Include="Pe.Revit.Tasks" Version="$(PeSdkCompanionVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pe.App\Pe.App.csproj" />
        <ProjectReference Include="..\Pe.Revit.FamilyFoundry\Pe.Revit.FamilyFoundry.csproj" />
        <ProjectReference Include="..\Pe.Revit\Pe.Revit.csproj" />
        <ProjectReference Include="..\Pe.Revit.Global\Pe.Revit.Global.csproj" />
        <ProjectReference Include="..\Pe.Revit.Scripting\Pe.Revit.Scripting.csproj" />
        <ProjectReference Include="..\Pe.Revit.Takeoff\Pe.Revit.Takeoff.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Fixtures\Profiles\**\*.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Fixtures\FamilyModel\**\*.json" CopyToOutputDirectory="PreserveNewest" />
        <EmbeddedResource
                Include="Fixtures\Profiles\family-model-evaluator.conformance.json"
                LogicalName="Pe.Revit.Tests.FamilyModelEvaluatorConformance.json" />
        <None Include="Fixtures\Families\**\*.rfa" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Fixtures\Projects\**\*.rvt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>NUnit.Version</_Parameter1>
            <_Parameter2>$(RevitVersion)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>NUnit.Language</_Parameter1>
            <_Parameter2>ENU</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>NUnit.Verbosity</_Parameter1>
            <_Parameter2>1</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>NUnit.Timeout</_Parameter1>
            <_Parameter2>20</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <PropertyGroup>
        <PeRevitRawDotNetTestWarningSuppressed Condition="'$(PeRevitRawDotNetTestWarningSuppressed)' == ''">false</PeRevitRawDotNetTestWarningSuppressed>
        <PeVerifyTarget Condition="'$(PeVerifyTarget)' == '' and '$(PeRevitRawDotNetTestWarningSuppressed)' != 'true' and $([System.String]::Copy('$(Configuration)').Contains('.Tests')) == 'True'">attached</PeVerifyTarget>
    </PropertyGroup>
    <Target
            Name="ValidateDotNetTestUsage"
            BeforeTargets="VSTest"
            Condition="'$(PeRevitRawDotNetTestWarningSuppressed)' != 'true'"
    >
        <Error
                Condition="$([System.String]::Copy('$(Configuration)').Contains('.Tests')) != 'True'"
                Text="`dotnet test` for `Pe.Revit.Tests` requires an explicit `.Tests` configuration such as `Debug.R25.Tests`. AGENT GUIDANCE: the attached lane validates against assemblies already loaded in the controlled session. If runtime code changed, coordinate runtime refresh through SDK `pe-revit session converge` before attached `.Tests`; an isolated dotnet build is not runtime freshness proof. Use SDK `pe-revit test --project &lt;csproj&gt;` (the fresh rung) when attached freshness is uncertain or current document state does not matter."
        />
    </Target>
    <!--
      Do not confuse isolated `.Tests` build outputs with isolated test execution.
      The build artifacts under `.artifacts/...` are safe to produce without touching
      any Revit session, but explicit-year VSTest execution is Revit-backed and defaults
      to the `attached` verify target unless the repo guardrails are intentionally suppressed.
      SDK `pe-revit test` with the attach flag owns attached session health checks. After runtime
      edits, coordinate runtime refresh (`pe-revit session converge`) before attached
      `.Tests` validation.
    -->
</Project>
