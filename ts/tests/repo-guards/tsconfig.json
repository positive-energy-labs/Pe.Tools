{
  "compilerOptions": {
    "target": "ESNext",
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "src/schema-names.guard.test.ts",
    "src/route-closure*.ts",
    "src/product-names.guard.test.ts",
    "src/product-layers*.ts",
    "src/product-assembly.guard.test.ts",
    "src/*product*imports.guard.test.ts",
    "src/workspace-boundary*.ts"
  ]
}
