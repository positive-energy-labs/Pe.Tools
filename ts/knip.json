{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    ".artifacts/**",
    "**/dist/**",
    "**/dist-installed/**",
    "**/vendor/**",
    "**/*.generated.ts",
    "**/routeTree.gen.ts",
    "apps/host/src/pages/**"
  ],
  "ignoreBinaries": ["vp", "vpx", "reg.exe", "tailscale"],
  "ignoreDependencies": [
    "@typescript/native-preview",
    "bumpp",
    "jiti",
    "@opentui/solid",
    "@family-fixtures/.*",
    "@agentclientprotocol/claude-agent-acp",
    "@agentclientprotocol/codex-acp"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "tests/e2e/*.ts"]
    },
    "apps/host": {
      "entry": ["src/index.ts", "src/dev.ts", "scripts/*.{ts,mjs}", "tests/fake-acp-agent.mjs"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.{ts,tsx}!", "scripts/*"]
    },
    "packages/factory": {
      "entry": ["actuators/*.ts", "sensors/*.ts"]
    },
    "packages/host-contracts": {
      "entry": ["scripts/*.ts"]
    },
    "packages/mcps": {
      "entry": ["src/server.ts"]
    },
    "tests/e2e": {
      "entry": ["*.ts"]
    },
    "tests/repo-guards": {}
  }
}
