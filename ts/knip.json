{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    ".artifacts/**",
    "**/dist/**",
    "**/dist-installed/**",
    "**/vendor/**",
    "**/*.generated.ts",
    "**/routeTree.gen.ts",
    "apps/host/src/pages/**"
  ],
  "ignoreBinaries": ["vp", "vpx", "reg.exe", "tailscale", "explorer.exe"],
  "ignoreDependencies": [
    "@typescript/native-preview",
    "bumpp",
    "jiti",
    "@opentui/solid",
    "@family-fixtures/.*",
    "@agentclientprotocol/claude-agent-acp",
    "@agentclientprotocol/codex-acp"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "tests/e2e/*.ts"]
    },
    "apps/host": {
      "entry": [
        "src/index.ts",
        "src/dev.ts",
        "scripts/*.{ts,mjs}",
        "tests/fake-acp-agent.mjs",
        "tests/native-recordings/record-view-image.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.{ts,tsx}!",
        "src/revit/revit.js",
        "src/route/ducts-chooser-layout.test.fixture.tsx",
        "scripts/*"
      ]
    },
    "packages/agent-contracts": {
      "entry": ["src/*.typecheck.ts"]
    },
    "packages/host-contracts": {
      "entry": ["scripts/*.ts", "src/generated/native-effect-direction.typecheck.ts"]
    },
    "packages/host-internal": {
      "entry": ["src/request-contracts.typecheck.ts", "src/tests/*.typecheck.ts"]
    },
    "packages/web-kernel": {
      "entry": ["src/route/tests/*.typecheck.ts"]
    },
    "products/*/contract": {
      "entry": ["src/tests/*.typecheck.ts"]
    },
    "packages/kit": {
      "entry": ["tests/browser.mjs"]
    },
    "packages/browser": {
      "entry": ["src/index.ts", "src/cli.ts", "src/keeper.ts", "tests/fixtures/*.ts"]
    },
    "packages/mcps": {
      "entry": ["src/server.ts"]
    },
    "tests/e2e": {
      "entry": ["*.ts"]
    },
    "products/fans/web": {
      "entry": ["journeys/*.ts", "journeys/*.journey.test.tsx", "vite.test.config.ts"]
    },
    "products/rooms/web": {
      "entry": ["journeys/*.journey.test.tsx", "vite.test.config.ts"]
    },
    "products/duct-systems/web": {
      "entry": ["journeys/*.{ts,tsx}"]
    },
    "tests/journey-fixtures": {
      "entry": ["*.ts", "jv3-field-fixture.tsx"]
    },
    "tests/repo-guards": {
      "entry": ["src/product-removed.ts"]
    }
  }
}
