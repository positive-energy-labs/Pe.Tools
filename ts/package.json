{
  "name": "pe-tools",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tests/*",
      "tools/*"
    ],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.1",
      "vite-plus": "0.2.1"
    }
  },
  "type": "module",
  "scripts": {
    "codegen": "pnpm --filter @pe/host-contracts codegen",
    "verify": "node scripts/verify.ts",
    "test": "vp run -r test",
    "dev": "vp run --filter @pe/host dev",
    "dev:no-revit": "vp run --filter @pe/host dev:no-revit"
  },
  "devDependencies": {
    "jiti": "^2.7.0",
    "knip": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.13.1"
}
