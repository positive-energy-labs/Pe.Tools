{
  "name": "@pe/agent-contracts",
  "version": "0.0.0",
  "description": "Protocol-shaped contracts for Pe.Tools agent workbench clients and UI shells.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./chat-state": {
      "types": "./src/chat-state.ts",
      "import": "./src/chat-state.ts"
    },
    "./code-format": {
      "types": "./src/code-format.ts",
      "import": "./src/code-format.ts"
    },
    "./pe-api": {
      "types": "./src/pe-api.ts",
      "import": "./src/pe-api.ts"
    },
    "./product-map": {
      "types": "./src/product-map.ts",
      "import": "./src/product-map.ts"
    },
    "./route-kernel-codecs": {
      "types": "./src/route-kernel-codecs.ts",
      "import": "./src/route-kernel-codecs.ts"
    },
    "./subject-ref": {
      "types": "./src/subject-ref.ts",
      "import": "./src/subject-ref.ts"
    },
    "./route-state": {
      "types": "./src/route-state.ts",
      "import": "./src/route-state.ts"
    },
    "./semantic-actions": {
      "types": "./src/semantic-actions.ts",
      "import": "./src/semantic-actions.ts"
    },
    "./command-axes": {
      "types": "./src/command-axes.ts",
      "import": "./src/command-axes.ts"
    },
    "./work-value": "./src/work-value.ts",
    "./space-view": "./src/space-view.ts",
    "./ducts-guide": {
      "types": "./src/ducts-guide.ts",
      "import": "./src/ducts-guide.ts"
    },
    "./value": "./src/value.ts",
    "./takeoff-adoption": "./src/takeoff-adoption.ts",
    "./takeoff-read": "./src/takeoff-read.ts",
    "./slots": "./src/slots/index.ts",
    "./target": "./src/target.ts",
    "./native-output-read": "./src/native-output-read.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "codegen:routes": "node ../../apps/web/scripts/route-graphs.ts && node scripts/route-links-cs.ts",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@pe/host-contracts": "workspace:*",
    "zod": "4.3.6",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  }
}
