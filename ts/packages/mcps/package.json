{
  "name": "@pe/mcps",
  "version": "0.0.0",
  "description": "Pe tool surfaces exposed as MCP servers (pea product).",
  "homepage": "https://github.com/author/library#readme",
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "license": "MIT",
  "author": "Author Name <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./product-catalog": "./src/pea/product-catalog.generated.ts",
    "./product-actions": "./src/pea/product-actions.generated.ts",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": "./src/server.ts",
    "./actions": "./src/shared/takeoff-action-client.ts",
    "./build": "./scripts/stage-liteparse.ts",
    "./takeoff-ops": "./src/shared/takeoff-ops.ts",
    "./family-pdf": "./src/shared/family-pdf.ts",
    "./llama-parse": "./src/shared/llama-parse.ts",
    "./llama-key": "./src/shared/llama-key.ts",
    "./derived-parse": "./src/shared/derived-parse.ts",
    "./product-contracts": "./src/pea/product-contracts.generated.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "codegen": "node --import jiti/register scripts/command-axes.ts",
    "codegen:check": "node --import jiti/register scripts/command-axes.ts --check",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@pe/duct-systems-contract": "workspace:*",
    "@llamaindex/liteparse": "catalog:",
    "@llamaindex/llama-cloud": "^2.10.0",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@pe/agent-contracts": "workspace:*",
    "@pe/ducts-contract": "workspace:*",
    "@pe/browser": "workspace:*",
    "@pe/host-contracts": "workspace:*",
    "@pe/runtime": "workspace:*",
    "effect": "4.0.2",
    "gunshi": "^0.29.5",
    "parse5": "^8.0.1",
    "pngjs": "catalog:",
    "zod": "4.3.6",
    "@pe/fans-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/pngjs": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "pe": {
    "generatedProductDependencies": [
      "@pe/duct-systems-contract",
      "@pe/ducts-contract",
      "@pe/fans-contract"
    ]
  }
}
