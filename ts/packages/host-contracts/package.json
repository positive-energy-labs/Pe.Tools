{
  "name": "@pe/host-contracts",
  "version": "0.0.0",
  "description": "Generated Pe host Effect schemas and RPC contracts.",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./script-revision": {
      "types": "./src/script-revision.ts",
      "import": "./src/script-revision.ts",
      "default": "./src/script-revision.ts"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "import": "./src/contracts/index.ts",
      "default": "./src/contracts/index.ts"
    },
    "./failure-summary": {
      "types": "./src/failure-summary.ts",
      "import": "./src/failure-summary.ts",
      "default": "./src/failure-summary.ts"
    },
    "./shared-keys": {
      "types": "./src/shared-keys.ts",
      "import": "./src/shared-keys.ts",
      "default": "./src/shared-keys.ts"
    },
    "./kinds": {
      "types": "./src/kinds.ts",
      "import": "./src/kinds.ts",
      "default": "./src/kinds.ts"
    },
    "./product-paths": {
      "types": "./src/product-paths.ts",
      "import": "./src/product-paths.ts",
      "default": "./src/product-paths.ts"
    },
    "./operation-types": {
      "types": "./src/operation-types.ts",
      "import": "./src/operation-types.ts",
      "default": "./src/operation-types.ts"
    },
    "./catalog": {
      "types": "./src/generated/host-catalog.generated.ts",
      "import": "./src/generated/host-catalog.generated.ts",
      "default": "./src/generated/host-catalog.generated.ts"
    },
    "./generated": {
      "types": "./src/generated/host-ops.generated.ts",
      "import": "./src/generated/host-ops.generated.ts",
      "default": "./src/generated/host-ops.generated.ts"
    },
    "./service-identity": {
      "types": "./src/service-identity.ts",
      "import": "./src/service-identity.ts",
      "default": "./src/service-identity.ts"
    },
    "./pe-service": {
      "types": "./src/vendor/pe-service.ts",
      "import": "./src/vendor/pe-service.ts",
      "default": "./src/vendor/pe-service.ts"
    },
    "./pe-service-host": {
      "types": "./src/vendor/pe-service-host.ts",
      "import": "./src/vendor/pe-service-host.ts",
      "default": "./src/vendor/pe-service-host.ts"
    },
    "./pe-revit-contract": {
      "types": "./src/vendor/generated/pe-revit-contract.ts",
      "import": "./src/vendor/generated/pe-revit-contract.ts",
      "default": "./src/vendor/generated/pe-revit-contract.ts"
    },
    "./pe-revit-cli": {
      "types": "./src/vendor/pe-revit-cli.ts",
      "import": "./src/vendor/pe-revit-cli.ts",
      "default": "./src/vendor/pe-revit-cli.ts"
    },
    "./pe-api": {
      "types": "./src/pe-api.ts",
      "import": "./src/pe-api.ts",
      "default": "./src/pe-api.ts"
    },
    "./settings-schema": "./src/settings-schema.ts",
    "./native-adapter": "./src/native-adapter.ts",
    "./host-descriptor": "./src/host-descriptor.ts",
    "./decoders": "./src/decoders.ts",
    "./native-schemas": "./src/native-schemas.ts",
    "./native-effect": "./src/generated/native-effect.generated.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "check:native-effect": "vpx tsc --project tsconfig.native-effect.json",
    "prepublishOnly": "vp run build",
    "codegen:sdk-wire": "node scripts/sdk-wire.ts",
    "codegen": "node scripts/sdk-wire.ts && dotnet run --disable-build-servers --project ../../../dotnet/Pe.Dev.Cli -- ops-catalog --out .cache/ops-catalog.json && vpx node --import jiti/register scripts/host-typegen.ts --catalog .cache/ops-catalog.json && node scripts/ops-catalog-hash.ts --write",
    "codegen:check": "node scripts/sdk-wire.ts --check && dotnet run --disable-build-servers --project ../../../dotnet/Pe.Dev.Cli -- ops-catalog --out .cache/ops-catalog.json && vpx node --import jiti/register scripts/host-typegen.ts --catalog .cache/ops-catalog.json --check && node scripts/ops-catalog-hash.ts",
    "codegen:verify-live": "vpx node --import jiti/register scripts/host-typegen.ts --check"
  },
  "dependencies": {
    "effect": "4.0.2",
    "json-schema-to-typescript": "catalog:",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  }
}
