{
  "name": "@pe/host",
  "version": "0.0.0",
  "private": true,
  "description": "Effect TS host: serves the Revit bridge WebSocket and Effect RPC endpoint.",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "start": "vp exec jiti src/index.ts",
    "dev": "vp exec node scripts/dev-watch.ts --take-over-host",
    "dev:no-revit": "vp exec node scripts/dev-watch.ts --take-over-host --no-revit",
    "attach": "vp exec node --import jiti/register src/dev.ts",
    "build": "vp pack",
    "build:payload": "pnpm run build && pnpm --filter @pe/kit build && pnpm --filter @pe/web build && node scripts/stage-web.ts && node scripts/stage-source.mjs && node scripts/stage-tray.mjs",
    "test": "vp test",
    "test:browser": "vp test run --mode browser --maxWorkers=1",
    "check": "vp check"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "catalog:",
    "@agentclientprotocol/codex-acp": "catalog:",
    "@agentclientprotocol/sdk": "catalog:",
    "@effect/platform-node": "4.0.2",
    "@pe/agent-contracts": "workspace:*",
    "@pe/browser": "workspace:*",
    "@pe/ducts-domain": "workspace:*",
    "@pe/host-contracts": "workspace:*",
    "@pe/host-internal": "workspace:*",
    "@pe/mcps": "workspace:*",
    "@pe/runtime": "workspace:*",
    "@posthog/mcp": "0.22.3",
    "ajv": "catalog:",
    "effect": "4.0.2",
    "parse5": "^8.0.1",
    "posthog-node": "5.55.2",
    "zod": "catalog:",
    "@pe/duct-systems-contract": "workspace:*",
    "@pe/duct-systems-host": "workspace:*",
    "@pe/ducts-host": "workspace:*",
    "@pe/ducts-web": "workspace:*",
    "@pe/fans-contract": "workspace:*",
    "@pe/fans-host": "workspace:*",
    "jiti": "^2.7.0",
    "@pe/web": "workspace:*",
    "@pe/duct-systems-web": "workspace:*",
    "@pe/fans-web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "playwright-core": "1.60.0",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "config": {
    "windowsBinaries": {
      "where": "where.exe",
      "attrib": "attrib.exe"
    }
  },
  "exports": {
    "./settings": "./src/settings.ts",
    "./family-actions": "./src/family-actions.ts",
    "./family-spec": "./src/family-spec.ts",
    "./read-graph": "./src/reads/door.ts",
    "./reads/evaluator": "./src/reads/evaluator.ts",
    "./builtin-read-handles": "./src/builtin-read-handles.ts",
    "./ducts-files": "./src/ducts-files.ts",
    "./ducts-inputs": "./src/ducts-inputs.ts",
    "./local-inputs": "./src/local-inputs.ts",
    "./reads/inputs": "./src/reads/inputs.ts",
    "./bridge": "./src/bridge.ts",
    "./command-executor": "./src/command-executor.ts",
    "./vite.config": "./vite.config.ts",
    "./command-read-identity": "./src/command-read-identity.ts",
    "./request-services": "./src/request-services.ts",
    "./action-journal": "./src/action-journal.ts",
    "./document-lifetime": "./src/document-lifetime.ts",
    "./tiered-settings": "./src/tiered-settings.ts",
    "./host-ownership": "./src/host-ownership.ts",
    "./index": "./src/index.ts",
    "./input-occurrence": "./src/input-occurrence.ts",
    "./native-reads": "./src/native-reads.ts",
    "./native-recording": "./src/native-recording.ts",
    "./call-route": "./src/call-route.ts"
  }
}
