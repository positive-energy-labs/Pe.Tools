{
  "name": "@pe/host",
  "version": "0.0.0",
  "private": true,
  "description": "Effect TS host: serves the Revit bridge WebSocket and Effect RPC endpoint.",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "start": "vp exec jiti src/index.ts",
    "dev": "vp exec node scripts/dev-watch.ts --take-over-host",
    "dev:no-revit": "vp exec node scripts/dev-watch.ts --take-over-host --no-revit",
    "attach": "vp exec node --import jiti/register src/dev.ts",
    "build": "vp pack",
    "build:payload": "pnpm run build && pnpm --filter @pe/kit build && pnpm --filter @pe/web build && node scripts/stage-web.mjs && node scripts/stage-source.mjs && node scripts/stage-tray.mjs",
    "test": "pnpm --filter @pe/kit build && vp test",
    "test:browser": "vp test run --mode browser --maxWorkers=1",
    "check": "vp check"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "catalog:",
    "@agentclientprotocol/codex-acp": "catalog:",
    "@agentclientprotocol/sdk": "catalog:",
    "@effect/platform-node": "4.0.2",
    "@pe/agent-contracts": "workspace:*",
    "@pe/browser": "workspace:*",
    "@pe/ducts-domain": "workspace:*",
    "@pe/host-contracts": "workspace:*",
    "@pe/host-internal": "workspace:*",
    "@pe/mcps": "workspace:*",
    "@pe/runtime": "workspace:*",
    "@posthog/mcp": "0.22.3",
    "ajv": "catalog:",
    "effect": "4.0.2",
    "parse5": "^8.0.1",
    "posthog-node": "5.55.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "playwright-core": "1.60.0",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "config": {
    "windowsBinaries": {
      "where": "where.exe",
      "attrib": "attrib.exe"
    }
  },
  "exports": {
    "./settings": "./src/settings.ts",
    "./family-actions": "./src/family-actions.ts",
    "./family-spec": "./src/family-spec.ts",
    "./read-graph": "./src/reads/door.ts",
    "./reads/evaluator": "./src/reads/evaluator.ts"
  }
}
