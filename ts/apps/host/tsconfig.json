{
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist-installed"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "#/*": ["./src/*"]
    },
    "lib": ["ESNext", "DOM"],
    "types": ["node"],

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // tsc reuses its last check; the build info lives under ignored node_modules.
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc.tsbuildinfo",

    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true
  }
}
