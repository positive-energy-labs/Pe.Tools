<Project Sdk="Pe.Revit.Sdk">

    <PropertyGroup>
        <PeProjectKind>Explicit</PeProjectKind>
    </PropertyGroup>
    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="NUnit" Version="3.13.3" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
        <PackageReference Include="Pe.Revit.Versioning" Version="$(PeSdkCompanionVersion)" />
        <!-- IPePayload / PePayloadContext: the payload contract Pe.App's entry point is typed against. -->
        <PackageReference Include="Pe.Revit.Loader" Version="$(PeSdkCompanionVersion)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../ts/packages/host-contracts/tests/runtime-ownership.fixture.json" Link="runtime-ownership.fixture.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- The dev bridge supervisor's real appBase derivation, compiled in so a test reads it without Revit. -->
        <Compile Include="..\Pe.App\Host\TsHostLauncher.cs" Link="Product\TsHostLauncher.cs" />
        <Compile Include="..\..\eng\PrivateFixtures.cs" Link="PrivateFixtures.cs" />
        <!-- Portable receipt producer uses the owning build configuration, without a runtime compiler. -->
        <Compile Include="..\Pe.App\Analytics\ReceiptEventIds.cs" Link="Operations\ReceiptEventIds.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pe.Aps\Pe.Aps.csproj" />
        <ProjectReference Include="..\Pe.Dev.RevitAutomation\Pe.Dev.RevitAutomation.csproj" />
        <ProjectReference Include="..\Pe.Revit\Pe.Revit.csproj" />
        <ProjectReference Include="..\Pe.Revit.Global\Pe.Revit.Global.csproj" />
        <ProjectReference Include="..\Pe.Revit.FamilyFoundry\Pe.Revit.FamilyFoundry.csproj" />
        <ProjectReference Include="..\Pe.Revit.Partition\Pe.Revit.Partition.csproj" />
        <ProjectReference Include="..\Pe.Revit.Space\Pe.Revit.Space.csproj" />
        <ProjectReference Include="..\Pe.Revit.Takeoff\Pe.Revit.Takeoff.csproj" />
        <ProjectReference Include="..\Pe.Revit.Scripting\Pe.Revit.Scripting.csproj" />
        <!-- Pe.Host retired — HostOperationExecutorTests.cs removed with it. -->
        <ProjectReference Include="..\Pe.Shared.ApsAuth\Pe.Shared.ApsAuth.csproj" />
        <ProjectReference Include="..\Pe.Shared.HostContracts\Pe.Shared.HostContracts.csproj" />
        <ProjectReference Include="..\Pe.Shared.Product\Pe.Shared.Product.csproj" />
        <!-- RhvacToolOwnershipTests runs the real tool process: it must be told its owner and resolve scratch under it. -->
        <ProjectReference Include="..\Pe.Rhvac.Tool\Pe.Rhvac.Tool.csproj" />
        <ProjectReference Include="..\Pe.Shared.RevitAutomation\Pe.Shared.RevitAutomation.csproj" />
        <ProjectReference Include="..\Pe.Shared.RevitData\Pe.Shared.RevitData.csproj" />
        <ProjectReference Include="..\Pe.Shared.Scripting\Pe.Shared.Scripting.csproj" />
        <ProjectReference Include="..\Pe.Shared.StorageRuntime\Pe.Shared.StorageRuntime.csproj" />
    </ItemGroup>
</Project>
