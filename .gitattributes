# Auto detect text files and normalize line endings to LF in the repository
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout (CRLF on Windows, LF on Unix)
*.cs text diff=csharp
*.csproj text diff=csharp
*.xaml text
*.md text
*.json text
*.xml text
*.txt text
*.config text

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.dll binary
*.exe binary

# The TS workspace is formatted to LF (vp check); without this, autocrlf checkouts write CRLF and
# vp check can never be green on a clean tree while git sees phantom modifications after --fix.
ts/** text=auto eol=lf

# Company acceptance inputs retain their original bytes, including mixed line endings.
