# Auto detect text files and normalize line endings to LF in the repository
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout (CRLF on Windows, LF on Unix)
*.cs text diff=csharp
*.csproj text diff=csharp
*.xaml text
*.md text
*.json text
*.xml text
*.txt text
*.config text

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.dll binary
*.exe binary

# The TS workspace is formatted to LF (vp check); without this, autocrlf checkouts write CRLF and
# vp check can never be green on a clean tree while git sees phantom modifications after --fix.
ts/** text=auto eol=lf

# Generators emit LF; keep their tracked outputs identical after Windows checkout.
*.generated.cs text eol=lf
*.generated.ts text eol=lf
*.generated.json text eol=lf
ts/packages/host-contracts/src/native-adapter.schema.json text eol=lf

# Company acceptance inputs retain their original bytes, including mixed line endings.

# Shipped example Pods are byte-exact fixtures (tests read them, products copy them): LF on every checkout.
examples/pods/** text eol=lf

# Conflicts that carry no decision. A ledger is appended to, so both sides' lines are kept.
**/LEDGER.md merge=union
# A generated hash or artifact is never merged by hand: the `regen` driver keeps the current side,
# and the freshness guard stays red until `pnpm codegen` rewrites it.
# `python .agents/skills/check.py --fix` sets the driver; without it git reports the conflict as before.
ts/packages/host-contracts/src/generated/ops-catalog.sha merge=regen
